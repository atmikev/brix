{
	"name": "brix",
	"displayName": "Brix",
	"description": "Interactive code walkthroughs with AI-powered voice narration and editor highlighting.",
	"version": "0.2.0",
	"publisher": "atmikev",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"*"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "brix.togglePlayPause",
				"title": "Brix: Toggle Play/Pause"
			},
			{
				"command": "brix.next",
				"title": "Brix: Next Sub-segment"
			},
			{
				"command": "brix.prev",
				"title": "Brix: Previous Sub-segment"
			},
			{
				"command": "brix.nextSegment",
				"title": "Brix: Next Segment"
			},
			{
				"command": "brix.prevSegment",
				"title": "Brix: Previous Segment"
			},
			{
				"command": "brix.stop",
				"title": "Brix: Stop Walkthrough"
			},
			{
				"command": "brix.speedUp",
				"title": "Brix: Speed Up"
			},
			{
				"command": "brix.speedDown",
				"title": "Brix: Speed Down"
			},
			{
				"command": "brix.saveWalkthrough",
				"title": "Brix: Save Walkthrough"
			},
			{
				"command": "brix.loadWalkthrough",
				"title": "Brix: Load Walkthrough"
			},
			{
				"command": "brix.openDecisions",
				"title": "Brix: Open Decisions Panel"
			},
			{
				"command": "brix.openTheater",
				"title": "Brix: Open Theater View"
			},
			{
				"command": "brix.navigatorReviewDiff",
				"title": "Brix: Navigator — Review Working Tree Diff"
			},
			{
				"command": "brix.setNavigatorKey",
				"title": "Brix: Set Navigator API Key"
			}
		],
		"keybindings": [
			{
				"command": "brix.togglePlayPause",
				"key": "ctrl+shift+space",
				"when": "brix.walkthroughActive"
			},
			{
				"command": "brix.next",
				"key": "ctrl+shift+]",
				"when": "brix.walkthroughActive"
			},
			{
				"command": "brix.prev",
				"key": "ctrl+shift+[",
				"when": "brix.walkthroughActive"
			},
			{
				"command": "brix.nextSegment",
				"key": "ctrl+shift+alt+]",
				"when": "brix.walkthroughActive"
			},
			{
				"command": "brix.prevSegment",
				"key": "ctrl+shift+alt+[",
				"when": "brix.walkthroughActive"
			},
			{
				"command": "brix.stop",
				"key": "ctrl+shift+\\",
				"when": "brix.walkthroughActive"
			},
			{
				"command": "brix.speedUp",
				"key": "ctrl+shift+=",
				"when": "brix.walkthroughActive"
			},
			{
				"command": "brix.speedDown",
				"key": "ctrl+shift+-",
				"when": "brix.walkthroughActive"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "brix",
					"title": "Brix",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"brix": [
				{
					"type": "webview",
					"id": "brix.sidebar",
					"name": "Brix"
				}
			]
		},
		"configuration": {
			"title": "Brix",
			"properties": {
				"brix.navigator.provider": {
					"type": "string",
					"enum": [
						"off",
						"anthropic",
						"openai"
					],
					"default": "off",
					"scope": "machine",
					"description": "LLM provider for the built-in navigator (pair-programming partner). 'openai' covers any OpenAI-compatible server: OpenAI, Ollama, LM Studio. Machine-scoped so a workspace can't repoint it at another endpoint."
				},
				"brix.navigator.model": {
					"type": "string",
					"default": "claude-opus-5",
					"scope": "machine",
					"description": "Model id, e.g. claude-opus-5 or qwen3:8b."
				},
				"brix.navigator.baseUrl": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "Base URL for the openai provider, e.g. http://localhost:11434/v1. Ignored for anthropic. Machine-scoped so a workspace can't redirect your API key to another host."
				}
			}
		}
	},
	"scripts": {
		"compile": "esbuild src/extension.ts --bundle --platform=node --target=node18 --outfile=out/extension.js --external:vscode --format=cjs --sourcemap",
		"watch": "npm run compile -- --watch",
		"package": "npm run compile -- --minify && vsce package --no-dependencies"
	},
	"dependencies": {
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.85.0",
		"@types/ws": "^8.5.0",
		"esbuild": "^0.20.0",
		"typescript": "^5.3.0"
	}
}
